ter text-[12px] text-[#a3aaa5]\"\n                        >\n                          Ningún cliente coincide con la búsqueda.\n                        </td>\n                      </tr>\n                    ) : (\n                      clientesPagina.map((c) => (\n                        <tr\n                          key={c.id}\n                          className=\"border-b border-[#eef1ee] last:border-0 hover:bg-[#fafbfa]\"\n                        >\n                          <td className=\"px-4 py-3 font-medium\">{c.nombreRazonSocial}</td>\n                          <td className=\"px-4 py-3 text-[#5b635e]\">{c.identificacion || '—'}</td>\n                          <td className=\"px-4 py-3 text-[#5b635e]\">{c.telefono || '—'}</td>\n                          <td className=\"px-4 py-3 text-[#5b635e]\">{c.tipoCliente ?? '—'}</td>\n                          <td className=\"px-4 py-3\">\n                            <span\n                              className={[\n                                'rounded-full px-2.5 py-1 text-[11px] font-semibold',\n                                c.estado\n                                  ? 'bg-[#e7f2ea] text-[#176b3a]'\n                                  : 'bg-[#f2f3f2] text-[#8a938d]'\n                              ].join(' ')}\n                            >\n                              {c.estado ? 'Activo' : 'Inactivo'}\n                            </span>\n                          </td>\n                          <td className=\"px-4 py-3\">\n                            <div className=\"flex justify-end gap-1\">\n                              <button\n                                type=\"button\"\n                                title=\"Editar\"\n                                onClick={() => {\n                                  setClienteEditando(c)\n                                  setModalAbierto(true)\n                                }}\n                                className=\"flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] hover:bg-[#f0f4f0] hover:text-[#16834b]\"\n                              >\n                                <Pencil size={15} />\n                              </button>\n                              {c.estado && (\n                                <button\n                                  type=\"button\"\n                                  title=\"Eliminar\"\n                                  onClick={() => setClienteAEliminar(c)}\n                                  className=\"flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] hover:bg-[#fdf1f0] hover:text-[#dc5c52]\"\n                                >\n                                  <Trash2 size={15} />\n                                </button>\n                              )}\n                            </div>\n                          </td>\n                        </tr>\n                      ))\n                    )}\n                  </tbody>\n                </table>\n              ",[20111,21169],"      <nav\n                aria-label=\"Paginación\"\n                className=\"mt-4 flex flex-wrap items-center justify-between gap-3 text-[12px] text-[#8a938d]\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <span>Mostrar</span>\n                  <select\n                    value={porPagina}\n                    onChange={(e) => {\n                      setPorPagina(Number(e.target.value) as (typeof OPCIONES_POR_PAGINA)[number])\n                      setPagina(1)\n                    }}\n                    className=\"rounded-lg border border-[#e1e5e1] bg-white px-2 py-1\"\n                  >\n                    {OPCIONES_POR_PAGINA.map((n) => (\n                      <option key={n}>{n}</option>\n                    ))}\n                  </select>\n                  <span>de {clientesFiltrados.length} registros</span>\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    disabled={paginaSegura <= 1}\n                    onClick={() => setPagina((p) => Math.max(1, p - 1))}\n                    className=\"rounded-lg border border-[#e1e5e1] bg-white px-3 py-1.5 font-semibold disabled:opacity-40\"\n                  >\n                    Anterior\n                  </button>\n                  <span>\n                    Página {paginaSegura} de {totalPaginas}\n                  </span>\n                  <button\n                    disabled={paginaSegura >= totalPaginas}\n                    onClick={() => setPagina((p) => Math.min(totalPaginas, p + 1))}\n                    className=\"rounded-lg border border-[#e1e5e1] bg-white px-3 py-1.5 font-semibold disabled:opacity-40\"\n                  >\n                    Siguiente\n                  </button>\n                </div>\n              ",[21176,21185],"            </>\n          )",[21187,21197],"        </>\n      ) : (\n        ",[21200,21567],"          <div className=\"mb-4 flex h-10 items-center gap-2 rounded-xl border border-[#e1e5e1] bg-white px-3 text-[#929a95]\">\n            <Search size={16} />\n            <input\n              value={busquedaProveedor}\n              onChange={(e) => {\n                setBusquedaProveedor(e.target.value)\n                setPaginaProveedor(1)\n              }}\n              placeholder=\"Buscar por nombre, CI/RUC, teléfono...\"\n              className=\"w-full bg-transparent text-[13px] outline-none\"\n            />\n          ",[21574,23716],"          {proveedores.length === 0 ? (\n            <EmptyState\n              icon={Truck}\n              title=\"Todavía no hay proveedores registrados\"\n              description=\"Registra proveedores para seleccionarlos desde las compras de Stock.\"\n            />\n          ) : (\n            <ContenedorTabla\n              etiqueta=\"Lista de proveedores\"\n              reinicio={JSON.stringify([paginaProveedorSegura, limiteProveedor, busquedaProveedor])}\n              className=\"rounded-2xl border border-[#e2e7e2] bg-white\"\n            >\n              <table className=\"w-full min-w-[980px] text-left text-[13px]\">\n                <thead>\n                  <tr className=\"border-b border-[#e2e7e2] bg-[#fafbfa] text-[11px] font-bold uppercase tracking-wide text-[#8a938d]\">\n                    <th className=\"px-4 py-3\">Nombre</th>\n                    <th className=\"px-4 py-3\">CI / RUC</th>\n                    <th className=\"px-4 py-3\">Teléfono</th>\n                    <th className=\"px-4 py-3\">Correo</th>\n                    <th className=\"px-4 py-3\">N° Cuenta</th>\n                    <th className=\"px-4 py-3\">Estado</th>\n                    <th className=\"px-4 py-3 text-right\">Acciones</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  {proveedoresPagina.map((p) => (\n                    <tr\n                      key={p.id}\n                      className=\"border-b border-[#eef1ee] last:border-0 hover:bg-[#fafbfa]\"\n                    >\n                      <td className=\"px-4 py-3 font-medium\">{p.nombre}</td>\n                      <td className=\"px-4 py-3 text-[#5b635e]\">{p.ciRuc || '—'}</td>\n                      <td className=\"px-4 py-3 text-[#5b635e]\">{p.telefono || '—'}</td>\n                      <td className=\"px-4 py-3 text-[#5b635e]\">{p.correo || '—'}</td>\n                      <td className=\"px-4 py-3 text-[#5b635e]\">{p.numeroCuenta || '—'}</td>\n                      <td className=\"px-4 py-3\">\n                        <span\n                          className={[\n                            'rounded-full px-2.5 py-1 text-[11px] font-semibold',\n                            p.estado ? 'bg-[#e7f2ea] text-[#176b3a]' : 'bg-[#f2f3f2] text-[#8a938d]'\n                          ].join(' ')}\n                        >\n                          {p.estado ? 'Activo' : 'Inactivo'}\n                        </span>\n                      </td>\n                      <td className=\"px-4 py-3\">\n                        <div className=\"flex justify-end gap-1\">\n                          <button\n                            type=\"button\"\n                            title=\"Editar\"\n                            onClick={() => {\n                              setProveedorEditando(p)\n                              setModalProveedor(true)\n                            }}\n                            className=\"flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] hover:bg-[#f0f4f0] hover:text-[#16834b]\"\n                          >\n                            <Pencil size={15} />\n                          </button>\n                          {p.estado && (\n                            <button\n                              type=\"button\"\n                              title=\"Eliminar\"\n                              onClick={() => setProveedorAEliminar(p)}\n                              className=\"flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] hover:bg-[#fdf1f0] hover:text-[#dc5c52]\"\n                            >\n                              <Trash2 size={15} />\n                            </button>\n                          )}\n                        </div>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </ContenedorTabla>\n          )",[23718,23725],"        </>\n      )",[23728,23922],"      {modalAbierto && (\n        <ClienteFormModal\n          clienteEditando={clienteEditando}\n          clientes={clientes}\n          onGuardar={guardarCliente}\n          onCancelar={() => {\n            setModalAbierto(false)\n            setClienteEditando(null)\n          }}\n        />\n      )",[23924,24341],"      {vista === 'proveedores' && (\n        <Paginacion\n          total={proveedoresFiltrados.length}\n          limite={limiteProveedor}\n          numero={paginaProveedorSegura}\n          hayAnterior={paginaProveedorSegura > 1}\n          haySiguiente={paginaProveedorSegura < paginasProveedor}\n          anterior={() => setPaginaProveedor((p) => Math.max(1, p - 1))}\n          siguiente={() => setPaginaProveedor((p) => Math.min(paginasProveedor, p + 1))}\n          cambiarLimite={(n) => {\n            setLimiteProveedor(n)\n            setPaginaProveedor(1)\n          }}\n        />\n      )",[24343,24557],"      {modalProveedor && (\n        <ProveedorFormModal\n          proveedorEditando={proveedorEditando}\n          proveedores={proveedores}\n          onGuardar={guardarProveedor}\n          onCancelar={() => {\n            setModalProveedor(false)\n            setProveedorEditando(null)\n          }}\n        />\n      )",[24559,25275],"      {clienteAEliminar && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/30 p-4\">\n          <div className=\"w-full max-w-[420px] rounded-2xl bg-white p-6 shadow-xl\">\n            <div className=\"mb-4 flex items-center gap-3\">\n              <div className=\"flex h-11 w-11 items-center justify-center rounded-xl bg-[#fdf1f0] text-[#dc5c52]\">\n                <AlertTriangle size={20} />\n              </div>\n              <h2 className=\"font-bold\">¿Eliminar cliente?</h2>\n            </div>\n            <p className=\"mb-5 text-[13px] text-[#69716b]\">\n              Se marcará a <strong>{clienteAEliminar.nombreRazonSocial}</strong> como inactivo.\n            </p>\n            <div className=\"flex justify-end gap-3\">\n              <button\n                onClick={() => setClienteAEliminar(null)}\n                className=\"rounded-xl border px-4 py-2.5 text-[13px]\"\n              >\n                Cancelar\n              </button>\n              <button\n               ",[25300,25300],"                 ",[25307,25397],"                   await desactivarCliente(clie