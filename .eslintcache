nal\"\n              />\n            </FormField>\n            <FormField label=\"Teléfono\" error={errores.telefono}>\n              <input\n                maxLength={15}\n                value={form.telefono}\n                onChange={(e) => actualizar('telefono', e.target.value)}\n                className={inputClass(!!errores.telefono)}\n                placeholder=\"Opcional\"\n              />\n            </FormField>\n          ",[6188,6795],"      <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2\">\n            <FormField label=\"Correo electrónico\" error={errores.email}>\n              <input\n                type=\"email\"\n                maxLength={80}\n                value={form.email ?? ''}\n                onChange={(e) => actualizar('email', e.target.value)}\n                className={inputClass(!!errores.email)}\n              />\n            </FormField>\n            <FormField label=\"Tipo de cliente\">\n              <select\n                value={form.tipoCliente ?? ''}\n                onChange={(e) =>\n                  actualizar(\n                    'tipoCliente',\n                    (e.target.value || undefined) as TipoCliente | undefined\n                  )\n                }\n                className={inputClass(false)}\n              >\n                <option value=\"\">Sin especificar</option>\n                {TIPOS_CLIENTE.map((t) => (\n                  <option key={t}>{t}</option>\n                ))}\n              </select>\n            </FormField>\n          ",[6802,7017],"          <FormField label=\"Dirección\" error={errores.direccion}>\n            <input\n              maxLength={200}\n              value={form.direccion ?? ''}\n              onChange={(e) => actualizar('direccion', e.target.value)}\n              className={inputClass(!!errores.direccion)}\n            />\n          ",[7030,7206],"          <FormField label=\"Notas\">\n            <textarea\n              value={form.notas ?? ''}\n      