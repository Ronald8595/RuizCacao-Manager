    setError('')\n    if (Object.keys(campos).length) ",[1275,1275],[1294,1550],"  try {\n      await cambiarPassword(actual, nueva)\n      setActual('')\n      setNueva('')\n      setConfirmar('')\n      notificar('exito', 'Contraseña actualizada.')\n      onCerrar()\n    } catch (e) {\n      setError(e instanceof ErrorNegocio ? e.message : 'No se pudo cambiar la contraseña.')\n    } finally {\n      setOcupado(false)\n    ",[1553,1553],[1555,1568],"  const clase = ",[1631,2333]," const campoPassword = (\n    etiqueta: string,\n    valor: string,\n    setValor: (valor: string) => void,\n    visible: boolean,\n    setVisible: (valor: boolean) => void,\n    autoComplete: string,\n    autofocus = false\n  ): React.JSX.Element => (\n    <div className=\"relative mt-1\">\n      <input\n        data-autofocus={autofocus || undefined}\n        type={visible ? 'text' : 'password'}\n        autoComplete={autoComplete}\n        maxLength={128}\n        value={valor}\n        onChange={(e) => setValor(e.target.value)}\n        className={clase}\n      />\n      <button\n        type=\"button\"\n        aria-label={visible ? `Ocultar ${etiqueta}` : `Mostrar ${etiqueta}`}\n        aria-pressed={visible}\n        onClick={() => setVisible(!visible)}\n        className=\"absolute inset-y-0 right-0 flex w-12 items-center justify-center text-[#657069]\"\n      >\n        {visible ? <EyeOff size={18} /> : <Eye size={18} />}\n      </button>\n    ",[2341,2455]," )\n  return (\n    <ModalAccesible\n      tituloId=\"cambiar-password-titulo\"\n      onCerrar={() => {\n        if (!ocupado) onCerrar()\n      }}\n      ancho=\"max-w-md\"\n    ",[2457,2532],"      <h2 id=\"cambiar-password-titulo\" className=\"font-bold\">\n        Cambiar contraseña\n      ",[2538,2538],"    ",[2607,2852],"     <label className=\"block text-sm\">\n          Contraseña actual\n          {campoPassword(\n            'contraseña actual',\n            actual,\n            setActual,\n            verActual,\n 