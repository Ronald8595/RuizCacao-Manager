cha,\n    monto: 5,\n    tipo: 'Abono',\n    metodoPago: 'Efectivo',\n    observacion: marca\n  ",[2137,2238],"  await paso('gasto', 'crearGastoManual', {\n    fecha,\n    categoria: 'Otros',\n    concepto: '',\n    monto: 5,\n    observacion: marca\n  ",[2241,2395],"  await paso('jornal', 'crearGastoManual', {\n    fecha,\n    categoria: 'Mano de obra',\n    concepto: '',\n    monto: 7,\n    observacion: marca,\n    empleado_id: empleados[0].id,\n    tipo_pago: 'pago'\n  ",[2399,2399],[2432,2468]," = { crearDataset, idOperacion, marca }",[15082,15082],"\n ",[97,126],"\n  path = require('node:path'),\n ",[267,267],[336,511]," if (!fs.existsSync(origen))\n    throw Error(\n      'Falta la clave pública de producción. Define RUIZCACAO_RECOVERY_PUBLIC_KEY con su ruta externa. No se genera una clave de desarrollo.'\n    ",[513,513],[566,674]," if (\n    !/^-----BEGIN PUBLIC KEY-----[\\s\\S]*-----END PUBLIC KEY-----$/.test(pem) ||\n    pem.includes('PRIVATE KEY')\n  )\n   ",[724,724],[764,764],[857,908]," const normal = key.export({ type: 'spki', format: 'pem' ",[911,1012],"  if (!fs.existsSync(destino) || fs.readFileSync(destino, 'utf8') !== normal)\n    fs.writeFileSync(destino, ",[1020,1020],[1160,1238],"\n  try {\n    preparar()\n  } catch (e) {\n    console.error(e.message)\n    process.exitCode = 1\n  }\n",[8,31]," useState, type FormEvent ",[54,64]," Eye, EyeOff ",[94,106]," ErrorNegocio ",[152,184]," validarAcceso, type ErroresAcceso ",[234,244]," useAppData ",[285,300]," useNotificacion ",[425,473]," onCerrar }: { onCerrar: () => void }): React.JSX.Element ",[475,539],"  const { administrador, cambiarPassword } = useAppData(),\n    { notificar } = ",[557,715],"  const [actual, setActual] = useState(''),\n    [nueva, setNueva] = useState(''),\n    [confirmar, setConfirmar] = useState(''),\n    [error, setError] = useState(''),\n    [ocupado, setOcupado] = ",[731,849],"  const [verActual, setVerActual] = useState(false),\n    [verNueva, setVerNueva] = useState(fal