ientes}\n          onGuardar={guardarCliente}\n          onCancelar={() => {\n            setModalAbierto(false)\n            setClienteEditando(null)\n          }}\n        />\n      )",[23924,24341],"      {vista === 'proveedores' && (\n        <Paginacion\n          total={proveedoresFiltrados.length}\n          limite={limiteProveedor}\n          numero={paginaProveedorSegura}\n          hayAnterior={paginaProveedorSegura > 1}\n          haySiguiente={paginaProveedorSegura < paginasProveedor}\n          anterior={() => setPaginaProveedor((p) => Math.max(1, p - 1))}\n          siguiente={() => setPaginaProveedor((p) => Math.min(paginasProveedor, p + 1))}\n          cambiarLimite={(n) => {\n            setLimiteProveedor(n)\n            setPaginaProveedor(1)\n          }}\n        />\n      )",[24343,24557],"      {modalProveedor && (\n        <ProveedorFormModal\n          proveedorEditando={proveedorEditando}\n          proveedores={proveedores}\n          onGuardar={guardarProveedor}\n          onCancelar={() => {\n            setModalProveedor(false)\n            setProveedorEditando(null)\n          }}\n        />\n      )",[24559,25275],"      {clienteAEliminar && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/30 p-4\">\n          <div className=\"w-full max-w-[420px] rounded-2xl bg-white p-6 shadow-xl\">\n            <div className=\"mb-4 flex items-center gap-3\">\n              <div className=\"flex h-11 w-11 items-center justify-center rounded-xl bg-[#fdf1f0] text-[#dc5c52]\">\n                <AlertTriangle size={20} />\n              </div>\n              <h2 className=\"font-bold\">¿Eliminar cliente?</h2>\n            </div>\n            <p className=\"mb-5 text-[13px] text-[#69716b]\">\n              Se marcará a <strong>{clienteAEliminar.nombreRazonSocial}</strong> como inactivo.\n            </p>\n            <div className=\"flex justify-end gap-3\">\n              <button\n                onClick={() => s