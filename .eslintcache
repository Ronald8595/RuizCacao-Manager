ltroTipo}\n                  onChange={(e) => {\n                    setFiltroTipo(e.target.value as TipoCliente | 'Todos')\n                    setPagina(1)\n                  }}\n                  className=\"h-10 rounded-xl border border-[#e1e5e1] bg-white px-3 text-[13px]\"\n                >\n                  <option value=\"Todos\">Todos los tipos</option>\n                  {TIPOS_CLIENTE.map((t) => (\n                    <option key={t}>{t}</option>\n                  ))}\n                </select>\n                <label className=\"flex h-10 items-center gap-2 rounded-xl border border-[#e1e5e1] bg-white px-3 text-[12px]\">\n                  <input\n                    type=\"checkbox\"\n                    checked={mostrarInactivos}\n                    onChange={(e) => {\n                      setMostrarInactivos(e.target.checked)\n                      setPagina(1)\n                    }}\n                  />\n                  Mostrar inactivos\n                </label>\n              ",[18068,20084],"              <ContenedorTabla\n                etiqueta=\"Lista de clientes\"\n                reinicio={JSON.stringify([\n                  paginaSegura,\n                  porPagina,\n                  busqueda,\n                  filtroTipo,\n                  mostrarInactivos\n                ])}\n                className=\"rounded-2xl border border-[#e2e7e2] bg-white\"\n              >\n                <table className=\"w-full min-w-[760px] text-left text-[13px]\">\n                  <thead>\n                    <tr className=\"border-b border-[#e2e7e2] bg-[#fafbfa] text-[11px] font-bold uppercase tracking-wide text-[#8a938d]\">\n                      <th className=\"px-4 py-3\">Nombre</th>\n                      <th className=\"px-4 py-3\">Identificación</th>\n                      <th className=\"px-4 py-3\">Teléfono</th>\n                      <th className=\"px-4 py-3\">Tipo</th>\n                      <th className=\"px-4 py-3\">Estado</th>