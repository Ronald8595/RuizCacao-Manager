earEmpleado', {\n        nombre: `QA Final Trabajador ${i === 1 ? 'Uno' : 'Dos'}`,\n        estado: true\n      })\n    ",[1122,1122],[1124,1217],"  for (const [i, producto, cantidad, pagado] of [\n    [0, 'Cacao en Baba', 20, 200],\n    [1, 'Cacao Seco', 10, 20]\n  ",[1220,1425],"    await paso('compra' + i, 'registrarCompra', {\n      fecha,\n      proveedorId: proveedores[i].id,\n      producto,\n      cantidadQq: cantidad,\n      precioCompraQq: 10,\n      impuestoPorcentaje: 0,\n      montoPagado: pagado,\n      metodoPago: 'Efectivo',\n      observacion: marca\n    ",[1428,1550],"  await paso('conversion', 'registrarConversionCacao', {\n    fecha,\n    cacaoBabaUtilizadoQq: 6.6,\n    factorConversion: 3.3,\n    observacion: marca\n  ",[1553,1567],"  const ventas = ",[1571,1618]," for (const [i, peso, pagado] of [\n    [0, 1, 20],\n    [1, 2, 10]\n  ",[1623,1854],"  ventas.push(\n      await paso('venta' + i, 'registrarVenta', {\n        fechaVenta: fecha,\n        clienteId: clientes[i].id,\n        producto: 'Cacao Seco',\n        pesoBruto: peso,\n        precioUnitario: 20,\n        impuestoPorcentaje: 0,\n        montoRecibido: pagado,\n        metodoPago: 'Efectivo',\n        observacion: marca\n      })\n    ",[1856,1924],"  const cuenta = (await db.cargar()).datos.cuentas.find((c) => c.ventaId === ",[1939,1950]," if (!cuenta) ",[2012,2134]," await paso('abono', 'registrarAbono', {\n    cuentaId: cuenta.id,\n    fecha,\n    monto: 5,\n    tipo: 'Abono',\n    metodoPago: 'Efectivo',\n    observacion: marca\n  ",[2137,2238],"  await paso('gasto', 'crearGastoManual', {\n    fecha,\n    categoria: 'Otros',\n    concepto: '',\n    monto: 5,\n    observacion: marca\n  ",[2241,2395],"  await paso('jornal', 'crearGastoManual', {\n    fecha,\n    categoria: 'Mano de obra',\n    concepto: '',\n    monto: 7,\n    observacion: marca,\n    empleado_id: empleados[0].id,\n    tipo_pago: 'pago'\n  ",[2399,2399],[2432,2468]," = { crearDataset, idOperacion, marca }",[97,1