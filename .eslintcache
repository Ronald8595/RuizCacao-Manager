\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => setVista('proveedores')}\n          className={[\n            'flex items-center gap-2 border-b-2 px-3 py-2.5 text-[13px] font-semibold',\n            vista === 'proveedores'\n              ? 'border-[#16834b] text-[#16834b]'\n              : 'border-transparent text-[#8a938d]'\n          ].join(' ')}\n        >\n          <Truck size={15} />\n          Proveedores\n        </button>\n      ",[16241,16269],"      {vista === 'clientes' ? (\n        ",[16272,16447],"          {clientes.length === 0 ? (\n            <EmptyState\n              icon={Users}\n              title=\"Todavía no hay clientes registrados\"\n              description=\"Usa el botón 'Nuevo cliente' para registrar el primero.\"\n            />\n          ) : (\n            ",[16450,17439],"              <div className=\"mb-4 flex flex-wrap items-center gap-3\">\n                <div className=\"flex h-10 min-w-[240px] flex-1 items-center gap-2 rounded-xl border border-[#e1e5e1] bg-white px-3 text-[#929a95]\">\n                  <Search size={16} />\n                  <input\n                    value={busqueda}\n                    onChange={(e) => {\n                      setBusqueda(e.target.value)\n                      setPagina(1)\n                    }}\n                    placeholder=\"Buscar por nombre o identificación...\"\n                    className=\"w-full bg-transparent text-[13px] outline-none\"\n                  />\n                </div>\n                <select\n                  value={filtroTipo}\n                  onChange={(e) => {\n                    setFiltroTipo(e.target.value as TipoCliente | 'Todos')\n                    setPagina(1)\n                  }}\n                  className=\"h-10 rounded-xl border border-[#e1e5e1] bg-white px-3 text-[13px]\"\n                >\n                  <option value=\"Todos\">Todos los tipos</option>\n                  {TIPOS_CLIENTE.map((